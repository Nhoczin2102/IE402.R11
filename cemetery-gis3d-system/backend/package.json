{
  "name": "cemetery-gis3d-backend",
  "version": "2.8.0",
  "description": "Backend REST API 3-tier Modular (PostgreSQL/PostGIS + Bố cục vòng tròn đồng tâm 240 mộ + Dynamic 3D Dijkstra + OpenAPI Scalar) cho Hệ thống Quy hoạch Nghĩa trang Đô thị GIS 3D (IE402.R11)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test tests/backend.test.js",
    "test:live": "node --test tests/live-api.test.js",
    "check": "node --check src/server.js && node --check src/app.js",
    "preview:2d": "node scripts/open-preview-2d.js"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^7.1.0",
    "pg": "^8.12.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
