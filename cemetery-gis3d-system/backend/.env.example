# Cấu hình máy chủ Backend
NODE_ENV=development
PORT=5000

# Cấu hình kết nối PostgreSQL / PostGIS (không commit file .env thật lên Git)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=cemetery_gis3d
DB_USER=admin
DB_PASSWORD=admin

# Tuỳ chọn Connection Pool & Bảo mật
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
